# 一個 case = 被包物 + 紙箱 + 包材參數 + 包法參數。
# 換被包物 / 換紙箱:複製這個檔案,改下面的路徑和參數,然後 ./run_wrap.sh --case cases/<新檔>.env
# 路徑都相對於 wrap_method_dev/。

# ── 被包物 ─────────────────────────────────────────────────────────────
ITEM=assets/items/mug.stl                         # STL,mm 或 m 都可以(自動判斷)
# ⚠ 物件躺平的姿態目前是為 mug.stl 寫死的(surface/wrap_sim.py PACK-1、volume/wrap_vol.py VPACK-1)

# ── 紙箱 ──────────────────────────────────────────────────────────────
CARTON=assets/cartons/carton_270x230x131.usd      # 旁邊要有同名 .meta.json(內腔、鉸鏈高度都從那裡讀)
# 做新的紙箱:carton/make_carton.sh <外長mm> <外寬mm> <高mm>  → assets/cartons/carton_<長>x<寬>x<高>.usd

# ── 外觀 ──────────────────────────────────────────────────────────────
TEX=assets/textures/bubble_normal.png

# ── 預設用哪個包材模型 ────────────────────────────────────────────────
ENGINE=volume                                     # volume | surface(run_wrap.sh --engine 可覆寫)

# ── 包材 + 包法參數(= 目前定案值)───────────────────────────────────
# volume:旗標說明見 volume/wrap_vol.py 開頭的 argparse;包法相關的是
#   --sheet_mm / --sheet_x_mm / --sheet_y_mm(布大小)、--fold_order(折序)、--margin / --wall(折線)、
#   --tip_over_mm(尖端越過中線)、--tuck / --squeeze_mm(收耳)、--mug_off_mm / --mug_yaw_deg(物件在布上的位置)
VOL_ARGS="--sheet_mm 500 --young 2e3 --tuck 1"
# surface:四段模擬共用的旗標(折序寫死 xp,xn,yp,yn)
SURF_ARGS="--wrapsim --thick 0.004 --hold_mm 6 --tip_over_mm 0 --sheet_mm 400 --layer_mm 5 --young 2e4 --bend 4"
